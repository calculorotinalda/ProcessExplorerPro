<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear all other local/corporate sources that might be overriding or serving a legacy WPF.UI package -->
    <clear />
    <!-- Force restore from the official public NuGet.org feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
