<UserControl x:Class="ProcessExplorerPro.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:ProcessExplorerPro.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
             
    <UserControl.Resources>
        <helpers:ComparisonConverter x:Key="ComparisonConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CONEXÕES DE REDE" Foreground="#5C62D6" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Atividade de Rede Ativa" Foreground="#E1E3E6" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding RefreshCommand}" 
                    VerticalAlignment="Center"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SegoeFluentFont}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="#161821" BorderBrush="#232530" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,6,30,6"
                             FontSize="12"/>
                    <!-- Search glass overlay -->
                    <TextBlock FontFamily="{StaticResource SegoeFluentFont}" Text="&#xE721;" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Protocol Filter Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="Protocolo:" Foreground="#848694" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <RadioButton Content="Todos" IsChecked="{Binding SelectedProtocol, Converter={StaticResource ComparisonConverter}, ConverterParameter=Todos}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="0,0,4,0"/>
                    <RadioButton Content="TCP" IsChecked="{Binding SelectedProtocol, Converter={StaticResource ComparisonConverter}, ConverterParameter=TCP}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="0,0,4,0"/>
                    <RadioButton Content="UDP" IsChecked="{Binding SelectedProtocol, Converter={StaticResource ComparisonConverter}, ConverterParameter=UDP}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connections Table -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding DisplayedConnections}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Background="#161821" 
                  BorderBrush="#232530" 
                  BorderThickness="1"
                  RowBackground="#161821"
                  AlternatingRowBackground="#191B26"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#232530"
                  HeadersVisibility="Column"
                  SelectionMode="Single">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#232530"/>
                    <Setter Property="Foreground" Value="#848694"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#232530"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E1E3E6"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Process Name -->
                <DataGridTemplateColumn Header="Nome do Processo" Width="200" SortMemberPath="ProcessName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SegoeFluentFont}" Text="&#xE704;" Foreground="#5C62D6" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- PID -->
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />

                <!-- Protocol -->
                <DataGridTemplateColumn Header="Protocolo" Width="90" SortMemberPath="Protocol">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#205C62D6">
                                <TextBlock Text="{Binding Protocol}" Foreground="#5C62D6" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Local Endpoint -->
                <DataGridTextColumn Header="Endereço Local" Binding="{Binding LocalEndpoint}" Width="220" />

                <!-- Remote Endpoint -->
                <DataGridTextColumn Header="Endereço Remoto" Binding="{Binding RemoteEndpoint}" Width="220" />

                <!-- Connection State -->
                <DataGridTemplateColumn Header="Estado" Width="150" SortMemberPath="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding State}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E1E3E6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="ESTABLISHED">
                                                <Setter Property="Foreground" Value="#2A9D8F"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="LISTENING">
                                                <Setter Property="Foreground" Value="#00B4D8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="SYN_SENT">
                                                <Setter Property="Foreground" Value="#FCA311"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="CLOSE_WAIT">
                                                <Setter Property="Foreground" Value="#E76F51"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
