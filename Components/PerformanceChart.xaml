<UserControl x:Class="ProcessExplorerPro.Components.PerformanceChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Grid Background="#0D0E15" ClipToBounds="True">
        <!-- Canvas for Grid Lines -->
        <Canvas x:Name="GridCanvas" Opacity="0.1" />
        
        <!-- Path for Gradient Fill Area -->
        <Path x:Name="AreaPath" Opacity="0.12">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GradientStopStart" Color="#5C62D6" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- Path for the Line -->
        <Path x:Name="LinePath" StrokeThickness="1.5">
            <Path.Stroke>
                <SolidColorBrush x:Name="LineStrokeBrush" Color="#5C62D6" />
            </Path.Stroke>
        </Path>

        <!-- Current Value Indicator Overlay -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,3" Background="#161821" CornerRadius="4" BorderBrush="#232530" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleLabel" Text="Usage" Foreground="#848694" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0"/>
                <TextBlock x:Name="ValueLabel" Text="0.0%" Foreground="#E1E3E6" FontSize="10" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
